# ============================================================
# 服装跟单智能工作台 - 环境变量模板
# 复制本文件为 .env 并填入真实值（.env 已被 gitignore，不会上传）
# ============================================================

# ---- Supabase（必填）----
# 在 Supabase 项目 -> Settings -> API 中获取
# 项目地址，形如 https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# anon public key（浏览器端使用，允许公开）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role key（仅本地批量导入脚本使用，绝不填到 Next.js 前端）
SUPABASE_SERVICE_ROLE_KEY=

# ---- DeepSeek（阶段2：AI 总结 / AI 助手，接入后启用）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 视觉模型（图片识别，OpenAI 兼容接口）----
# 已接入智谱 GLM-4V 系列；API Key 只放 .env，不要提交到 GitHub
VISION_MODEL_API_KEY=
# 智谱 OpenAI 兼容地址：https://open.bigmodel.cn/api/paas/v4
VISION_MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 默认模型（设置页可切换）：glm-4v-flash / glm-4.1v-thinking-flash /
# glm-4.6v-flash / glm-4.6v-flashx / glm-4.6v
VISION_MODEL_NAME=glm-4v-flash

# ---- 应用 ----
NEXT_PUBLIC_APP_NAME=服装跟单智能工作台
